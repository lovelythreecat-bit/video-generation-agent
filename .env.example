# Copy to .env. start-webapi.bat / start-webapi.ps1 load this file.
# Literal KEY=value syntax; optional matching quotes, no variable expansion or inline comments.
# Values in this file override inherited environment variables for this process only.
VIDEO_AGENT_API_HOST=127.0.0.1
VIDEO_AGENT_API_PORT=8000
VIDEO_AGENT_API_LOG_LEVEL=info
VIDEO_AGENT_DB_HOST=127.0.0.1
VIDEO_AGENT_DB_PORT=3306
VIDEO_AGENT_DB_NAME=video_agent
VIDEO_AGENT_DB_USER=video_agent
VIDEO_AGENT_DB_PASSWORD=
# Relative paths are resolved from the project directory by the startup script.
VIDEO_AGENT_HOME=.video-agent
VIDEO_AGENT_BUSINESS_TOKEN=
VIDEO_AGENT_ADMIN_TOKEN=
VIDEO_AGENT_SECRET_KEY=

# Tests must use a separate existing database named test_* or *_test.
VIDEO_AGENT_TEST_DB_HOST=127.0.0.1
VIDEO_AGENT_TEST_DB_PORT=3306
VIDEO_AGENT_TEST_DB_NAME=test_video_agent
VIDEO_AGENT_TEST_DB_USER=video_agent_test
VIDEO_AGENT_TEST_DB_PASSWORD=
